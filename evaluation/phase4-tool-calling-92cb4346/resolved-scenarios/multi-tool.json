      "requiredDependencies": [
        "validate_query -> materialize_query"
      ],
      "expectedResultAssertions": [
        "materialization uses returned validatedQueryId",
        "artifactId, rowCount and contentHash come from tool output",
        "no raw rows or storage path in final answer"
      ],
      "expectedFailureBehavior": "do not materialize when validation fails",
      "oracle": {
        "toolSet": "exact",
        "dependencies": "validate precedes materialize and id matches"
      }
    },
