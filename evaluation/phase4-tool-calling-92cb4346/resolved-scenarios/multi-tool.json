      "forbiddenTools": [
        "execute_query",
        "run_data_analysis"
      ],
      "inputArtifacts": [],
      "expectedArguments": {
        "validate_query": {
          "datasetId": "ads.ads_sales_daily",
          "select": [
            {
              "field": "revenue",
              "aggregation": "sum"
            }
          ],
          "filters": [
            {
              "field": "event_date",
              "operator": "between",
              "value": [
                "2026-07-25",
                "2026-07-31"
              ]
            }
          ]
        },
