{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pipeline-governance/flink-runtime-summary.schema.json",
  "title": "FlinkRuntimeSummary",
  "type": "object",
  "required": [
    "pipelineId",
    "pipelineVersion",
    "runId",
    "engine",
    "verified",
    "jobId",
    "status",
    "operators",
    "checkpoints",
    "watermark"
  ],
  "additionalProperties": false,
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "engine": {
      "const": "FLINK"
    },
    "jobId": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "enum": [
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "operators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "checkpoints": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "watermark": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "backpressure": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "verified": {
      "const": false
    },
    "pipelineId": {
      "type": "string",
      "minLength": 1
    },
    "pipelineVersion": {
      "type": "integer",
      "minimum": 1
    }
  }
}
