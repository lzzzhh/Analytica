{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pipeline-governance/remediation-proposal.schema.json",
  "title": "RemediationProposal",
  "type": "object",
  "required": [
    "proposalId",
    "findingId",
    "pipelineId",
    "runId",
    "actions",
    "status",
    "createdAt"
  ],
  "additionalProperties": false,
  "properties": {
    "proposalId": {
      "type": "string",
      "pattern": "^rp_[A-Za-z0-9_-]+$"
    },
    "findingId": {
      "type": "string",
      "minLength": 1
    },
    "pipelineId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "PENDING_APPROVAL",
        "APPROVED",
        "REJECTED",
        "APPLIED"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "approvedBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "appliedAt": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
