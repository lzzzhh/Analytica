{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "pipeline-governance/validation-issue.schema.json",
  "title": "ValidationIssue",
  "type": "object",
  "required": [
    "code",
    "severity",
    "message"
  ],
  "additionalProperties": false,
  "properties": {
    "code": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "INFO",
        "WARNING",
        "ERROR"
      ]
    },
    "message": {
      "type": "string"
    },
    "fieldPath": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
