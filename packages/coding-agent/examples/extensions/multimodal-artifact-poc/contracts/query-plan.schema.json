{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lzzzhh/data-agent/contracts/query-plan.schema.json",
  "title": "QueryPlan",
  "description": "Structured read-only query plan. Raw SQL is never accepted.",
  "type": "object",
  "required": ["datasetId", "select"],
  "properties": {
    "datasetId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$" },
    "select": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["field"],
        "properties": {
          "field": { "type": "string" },
          "aggregation": { "enum": ["sum", "count", "avg", "min", "max"] },
          "alias": { "type": "string" }
        }
      }
    },
    "dimensions": { "type": "array", "items": { "type": "string" } },
    "filters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "operator"],
        "properties": {
          "field": { "type": "string" },
          "operator": { "enum": ["eq", "neq", "gt", "gte", "lt", "lte", "between", "in", "is_null", "is_not_null"] },
          "value": {}
        }
      }
    },
    "limit": { "type": "integer", "minimum": 1, "maximum": 1000, "default": 100 }
  }
}
