# Lakehouse Gateway — 部署配置模板（复制为 .env 或 export 使用）
# 本地开发模式（无 AWS 凭据）
LAKEHOUSE_MODE=local
LAKEHOUSE_WAREHOUSE_PATH=./.data/warehouse
LAKEHOUSE_CATALOG_TYPE=local
LAKEHOUSE_GATEWAY_URL=http://localhost:8001

# 云端模式（需要环境中的 AWS 凭据）
# LAKEHOUSE_MODE=aws
# LAKEHOUSE_S3_WAREHOUSE=s3://<bucket>/<prefix>
# LAKEHOUSE_CATALOG_TYPE=glue
# AWS_REGION=us-east-1

# 查询边界
LAKEHOUSE_DEFAULT_LIMIT=100
LAKEHOUSE_MAX_LIMIT=1000
LAKEHOUSE_MAX_SCAN_ROWS=1000000
LAKEHOUSE_MAX_EXECUTION_MS=30000
LAKEHOUSE_ALLOW_ODS=false
LAKEHOUSE_MAX_RESULT_BYTES=262144

# 安全
LAKEHOUSE_SENSITIVE_FIELDS=customer_id,borrower_id,account_number,card_number,phone,email,id_number,ssn,id_card
LAKEHOUSE_AUDIT_LOG=.data/audit.log
LAKEHOUSE_RATE_LIMIT=60
